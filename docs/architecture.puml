@startuml architecture
title ИС «Сходим»: диаграмма классов общей архитектуры (этапы 3 и 4)
!pragma layout smetana
skinparam packageStyle rectangle
skinparam wrapWidth 160
skinparam class {
  BackgroundColor<<database>> #FFF8E1
  BackgroundColor<<component>> #E8F5E9
  BackgroundColor<<utility>> #ECEFF1
}
hide empty members
left to right direction

package "Уровень представления (Этап 4)" as presentation #EEEEEE {
  class "React SPA" as Spa <<component>>
  class AuthController
  class EventController
  class MeController
  class CompanionController
  class SocialController
  class AdminController
  class ApiExceptionHandler <<utility>>
  class SpaConfig <<utility>>
  class "Spring Security и JWT" as Security <<component>>
}

package "Уровень бизнес-логики" as business {
  class UserService
  class CatalogService
  class ReactionService
  class CompanionService
  class FeedbackService
  class ModerationService
  class ImportService
  class PresentationService
  class ShareCardService
  class RequestExpirationScheduler <<component>>
  class BusinessRuleException
  class NotFoundException
}

package "Уровень хранения" as storage {
  class UserRepository
  class CatalogRepository
  class ReactionIntentionRepository
  class CompanionRepository
  class FeedbackRepository
  class ModerationRepository
  class ImportRepository
  class PresentationRepository
  class RowMappers <<utility>>
  class MoreRowMappers <<utility>>
}

package "Доменная модель (22 сущности)" as domain {
  class AppUser
  class UserProfile
  class Category
  class Tag
  class Place
  class Event
  class EventSession
  class EventReaction
  class EventIntention
  class IntentionPeriod
  class CompanionRequest
  class Conversation
  class Message
  class EventFeedback
  class Notification
  class Report
  class ImportRun
  class CatalogEntry
  class RecommendedEvent
  class ConversationParticipant
  class Views <<utility>>
}

package "PostgreSQL (Этап 2)" as db {
  class "JdbcTemplate" as Jdbc <<framework>>
  class "pl/pgsql функции\nи процедуры" as Functions <<database>>
  class "22 таблицы\napp_schema" as Tables <<database>>
  note bottom of Jdbc
    Не ORM: этап 3 запрещает замещать
    pl/pgsql «аналогичным SQL» в Java.
    JdbcTemplate только вызывает функции
    этапа 2 и мапит строки в record.
  end note
}

Spa --> Security : REST /api/v1, JSON
Security --> AuthController
Security --> EventController
Security --> MeController
Security --> CompanionController
Security --> SocialController
Security --> AdminController
SpaConfig ..> Spa : отдаёт статику из JAR
AuthController --> UserService
EventController --> CatalogService
EventController --> ReactionService
EventController --> FeedbackService
EventController --> ShareCardService
EventController --> PresentationService
MeController --> UserService
MeController --> PresentationService
CompanionController --> CompanionService
CompanionController --> PresentationService
SocialController --> PresentationService
AdminController --> ImportService
AdminController --> ModerationService
AdminController --> PresentationService

UserService --> UserRepository
CatalogService --> CatalogRepository
ReactionService --> ReactionIntentionRepository
CompanionService --> CompanionRepository
FeedbackService --> FeedbackRepository
ModerationService --> ModerationRepository
ImportService --> ImportRepository
PresentationService --> PresentationRepository
RequestExpirationScheduler --> CompanionService : expireRequests()

business ..> BusinessRuleException
business ..> NotFoundException

storage ..> Jdbc
Jdbc --> Functions : CALL /\nSELECT function(...)
Functions --> Tables

UserRepository ..> RowMappers
CatalogRepository ..> RowMappers
ReactionIntentionRepository ..> MoreRowMappers
CompanionRepository ..> MoreRowMappers
FeedbackRepository ..> MoreRowMappers
ModerationRepository ..> MoreRowMappers
PresentationRepository ..> RowMappers
PresentationRepository ..> Views

storage --> domain : маппинг строк\nResultSet -> record

EventIntention --> IntentionPeriod : история периодов

@enduml
