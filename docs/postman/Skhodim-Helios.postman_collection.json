{
  "info": {
    "name": "Skhodim API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "SSH-туннель: ssh -L 18080:127.0.0.1:18080 -p 2222 s467667@helios.se.ifmo.ru\nSwagger: http://localhost:18080/swagger-ui.html\nДемо: demo1@example.org / Demo12345!\nМодератор: demo100@example.org / Demo12345!"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:18080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
    },
    {
      "name": "Login demo1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"demo1@example.org\",\"password\":\"Demo12345!\"}" },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Events search",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/events?query=концерт&isFree=true&metro=Невский проспект&limit=5"
      }
    },
    {
      "name": "Swipe feed",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/events?forYou=true&limit=5"
      }
    },
    {
      "name": "Event card",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/events/1" }
    },
    {
      "name": "Taste plate",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/me/taste"
      }
    },
    {
      "name": "Twin",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/me/twin"
      }
    },
    {
      "name": "Share card PNG",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/events/10/share-card"
      }
    }
  ]
}
